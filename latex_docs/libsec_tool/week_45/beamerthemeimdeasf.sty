\mode<presentation>

\definecolor{imdeasfblue}{RGB}{150,181,200}
\definecolor{imdeasfblue2}{RGB}{57,182,180}

\colorlet{imdeasfbluelight}{white!25!imdeasfblue}
\definecolor{imdeasfgray}{RGB}{127,127,127}
\setbeamercolor{structure}{fg=imdeasfblue}

\setbeamertemplate{navigation symbols}{}

\setbeamersize{text margin left=2em,text margin right=2em}

\setbeamercolor{block title}{use=structure,fg=white,bg=structure}
\setbeamercolor{block body}{parent=normal text,use=block title,fg=white,bg=imdeasfbluelight}

\setbeamercolor{framesubtitle}{fg=imdeasfgray}%

