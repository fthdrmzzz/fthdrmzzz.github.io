\defbeamertemplate*{footline}{infolines theme}
{%
  \leavevmode%
  \hspace{2ex}
  \hbox{%
    \begin{beamercolorbox}[wd=.20\paperwidth,ht=2.25ex,dp=3ex,left]{imdeasfblue}%
      \scriptsize\textcolor{imdeasfgray}{Fatih Durmaz}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.55\paperwidth,ht=2.25ex,dp=3ex,center]{imdeasfblue}%
      \scriptsize\textcolor{imdeasfgray}{\insertframenumber/\inserttotalframenumber}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.20\paperwidth,ht=2.25ex,dp=3ex,right]{imdeasfblue}%
      \scriptsize\textcolor{imdeasfgray}{\today}
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

\newcommand{\topline}{%
  \tikz[remember picture,overlay] {%
    \draw[line width=0.4mm, imdeasfblue2] ([yshift=-1.3cm,xshift=-1cm]current page.north west)
    -- ([yshift=-1.3cm,xshift=0.82\paperwidth]current page.north west);}}

\setbeamertemplate{frametitle}{%
  \vspace{1em}
%  \vphantom{g}% To avoid fluctuations per frame
  \strut\usebeamerfont{frametitle}\textcolor{black}\insertframetitle\strut
  \hfill
  \hspace{1em}
  \begin{beamercolorbox}[wd=.10\paperwidth,ht=2.25ex,dp=3ex,right]{imdeasfblue}%
    \includegraphics[width=1.5cm]{Figs/logo-en}
  \end{beamercolorbox}%
  %
  \topline
}%

